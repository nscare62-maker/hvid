# Local development only. Never commit your real .env.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
DATABASE_URL=sqlite:///hvid.db

# Optional integrations
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
OTP_EXPIRY_MINUTES=20
MAX_OTP_ATTEMPTS=3
ADMIN_KEY=replace-with-a-strong-admin-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Database bootstrap. Keep false on production when the database schema is managed separately.
AUTO_CREATE_DB=true
